  "events": {
    "welcome": {
      "speaker": "Muhammad Jan",
      "lines": [
        "Welcome to our village in Laghman. Walk with me to the Library; we will begin with a first hello.",
        "Use the arrows or WASD to move. Stand next to a person and press E, Enter or Interact. The paths connect all four neighbourhoods."
      ],
      "actions": [
        {
          "label": "I will meet you at the Library",
          "type": "flag",
          "flag": "metGuide"
        }
      ]
    },
    "library": {
      "speaker": "Muhammad Jan",
      "lines": [
        "Our Library holds everything you learn. Let us practise choosing a meaning, arranging Pashto words, choosing your gender preference, and giving your name."
      ],
      "actions": [
        {
          "label": "Begin Library tutorial",
          "type": "tutorial",
          "condition": "beforeTutorial"
        },
        {
          "label": "Open Library",
          "type": "reference",
          "condition": "afterTutorial"
        },
        {
          "label": "Replay tutorial",
          "type": "tutorial",
          "condition": "afterTutorial"
        }
      ]
    },
    "home": {
      "speaker": "Muhammad Jan",
      "lines": [
        "Welcome home. We can study descriptions together, or you can try the Day 1 challenge whenever you feel ready. You do not need to finish all four lessons first."
      ],
      "actions": [
        {
          "label": "Study at Home",
          "type": "lesson",
          "lessonId": "1-residential"
        },
        {
